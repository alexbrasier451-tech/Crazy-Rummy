# Public, origin-restricted Metered Realtime Messaging key. Never put an
# administrative or secret key in a VITE_* variable.
VITE_METERED_PUBLISHABLE_KEY=pk_live_replace_at_deployment

# Emergency public-discovery kill switch. Set false to disable all online
# presence/table-service construction while leaving the PWA and local harness.
VITE_CRAZY_RUMMY_ONLINE_ENABLED=false

# Build mount path. GitHub project Pages uses /Crazy-Rummy/; local builds use /.
CRAZY_RUMMY_BASE_PATH=/
